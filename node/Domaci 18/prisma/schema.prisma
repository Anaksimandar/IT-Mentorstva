// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  password  String  
}

model Event {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  ticket_price Float
  due_date     DateTime
  status       EventStatus @default(ACTIVE)
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
