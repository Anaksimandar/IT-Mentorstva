<head>
  <meta charset="UTF-8" />
  <title>Jobs</title>
  <link rel="stylesheet" href="/css/jobs.css" />
</head>

<h1>Jobs:</h1>

<% if (jobs.length === 0) { %>
  <p>No jobs found.</p>
<% } else { %>
  <% jobs.forEach(job => { %>
    <div class="job">
      <h2><%= job.title %></h2>
      <p><%= job.description %></p>

      <p><strong>Company:</strong> <%= job.company.name %></p>
      <p><strong>Posted by:</strong> <%= job.user.name %></p>
      <p><strong>Salary:</strong> €<%= job.salary %></p>
      <p><strong>Expires:</strong> <%= job.due_date.toISOString().split('T')[0] %></p>

      <div class="technologies">
        <strong>Technologies:</strong>
        <% if (job.technologies.length === 0) { %>
          <span>None listed</span>
        <% } else { %>
          <% job.technologies.forEach(tech => { %>
            <span class="tag"><%= tech.name %></span>
          <% }) %>
        <% } %>
      </div>

      <form action="/admin/job/remove" method="POST">
        <input type="hidden" name="id" value="<%= job.id %>" />
        <button type="submit">Delete</button>
      </form>
    </div>
  <% }) %>
<% } %>

<form action="/admin/job/create" method="post">
  <div>
    <label for="userId">Users</label>
    <select name="userId" id="userId">
      <% users.forEach(user => { %>
        <option value="<%= user.id %>"><%= user.name %></option>
      <% }) %>
    </select>
  </div>

  <div>
    <label for="companyId">Companies</label>
    <select name="companyId" id="companyId">
      <% companies.forEach(company => { %>
        <option value="<%= company.id %>"><%= company.name %></option>
      <% }) %>
    </select>
  </div>

  <div>
  <label>Technologies</label>
    <% technologies.forEach(technology => { %>
    <div>
        <input type="checkbox" name="technologies" id="tech-<%= technology.id %>" value="<%= technology.id %>" />
        <label for="tech-<%= technology.id %>"><%= technology.name %></label>
    </div>
    <% }) %>
    </div>

  <div>
    <input type="text" placeholder="Job title:" name="title" />
  </div>

  <div>
    <input type="text" placeholder="Job description" name="description" />
  </div>

  <div>
    <input type="number" min="0" max="100000" placeholder="Salary(euro)" name="salary" />
  </div>

  <div>
    <label for="due_date">Expires at:</label>
    <input type="date" placeholder="Due date" name="due_date" id="due_date" />
  </div>

  <button type="submit">Create</button>
</form>