<h1>Technologies</h1>
<% if (technologies.length === 0) { %>
  <p>No technologies found.</p>
<% } else { %>
    <% for (let i = 0; i < technologies.length; i++) { %>
      <div class="technology">
        <h2><%= technologies[i].name %></h2>
        <form action="/admin/technology/remove" method="get">
          <input type="hidden" name="id" value="<%= technologies[i].id %>" />
          <button type="submit">Delete</button>
        </form>
      </div>
    <% } %>
<% } %>


<form action="/admin/technology/add" method="POST">
  <button type="submit">Add</button>
  <input type="text" name="name" placeholder="Technology name" />
</form>
