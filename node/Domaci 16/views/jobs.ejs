<h1>Jobs:</h1>
<form action="/jobs/search" method="get">
    <div>
        <label for="title">Title</label>
        <input type="text" name="title" id="title" >
    </div>
    <div>
        <select name="technology">
            <option value="">all</option>
        <% technologies.forEach(technology => { %>
            <option value="<%= technology.id %>"><%= technology.name %></option><% }) %>
        </select>
    </div>
    <div>
    <label for="dueDate">Broj poseta:</label>
        <select name="sortBy" id="visits">
            <option value="ascending">Rastuci (manje ka vecem)</option>
            <option value="descending">Opadajuci (veci ka manjem)</option>
        </select>
    </div>
    <button type="submit">Search</button>
</form>
<% if (jobs.length === 0) { %>
  <p>No jobs found.</p>
<% } else { %>
  <% jobs.forEach(job => { %>
    <div class="job">
      <h2><%= job.title %></h2>
      <p><%= job.description %></p>

      <p><strong>Company:</strong> <%= job.company.name %></p>
      <p><strong>Posted by:</strong> <%= job.user.name %></p>
      <p><strong>Salary:</strong> €<%= job.salary %></p>
      <p><strong>Expires:</strong> <%= job.due_date.toISOString().split('T')[0] %></p>

      <div class="technologies">
        <strong>Technologies:</strong>
        <% if (job.technologies.length === 0) { %>
          <span>None listed</span>
        <% } else { %>
          <% job.technologies.forEach(tech => { %>
            <span class="tag"><%= tech.name %></span>
          <% }) %>
        <% } %>
      </div>
      <form action="/jobs/<%= job.id %>" method="GET">
          <button id="getJobByIdBtn" type="submit">See more</button>
      </form>
    </div>
  <% }) %>
<% } %>
  
   <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <% errors.forEach(function(error) { %>
      <p class="error-item"><%= error.msg %></p>
    <% }); %>
  </ul>
  <% } %>
</form>