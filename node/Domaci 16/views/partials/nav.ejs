<ul class="navbar-links">
  <% if (currentUser) { %>
    <% if (currentUser.role === "admin") { %>
      <li><a href="/admin/jobs">Manage Jobs</a></li>
      <li><a href="/admin/companies">Manage Companies</a></li>
      <li><a href="/admin/technologies">Manage Technologies</a></li>
    <% } else { %>
      <li><a href="/jobs">Jobs</a></li>
    <% } %>

    <li><a href="/dashboard">Dashboard</a></li>
    <li>
      <form action="/auth/logout" method="GET" class="navbar-logout-form">
        <button type="submit" class="navbar-logout-btn">Logout</button>
      </form>
    </li>
  <% } else { %>
    <li><a href="/login">Login</a></li>
    <li><a href="/register">Register</a></li>
  <% } %>
</ul>