<section class="auth-card" aria-labelledby="login-title">
  <h2 class="page-title" id="login-title">Welcome back</h2>
  <p class="section-copy">Sign in to continue shopping and view your orders.</p>
  <form action="/api/login" method="POST" class="auth-form">
    <div class="form-group">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" autocomplete="email" required />
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        autocomplete="current-password"
        required
      />
    </div>
    <button class="btn btn-primary" id="loginBtn" type="submit">Log in</button>
  </form>
  <p class="auth-help"><a href="/sign-in">Don’t have an account? Create one here</a></p>
</section>

<script>
  const loginBtn = document.getElementById("loginBtn");
  const loginUser = async () => {
    const email = document.querySelector('input[name="email"]').value;
    const password = document.querySelector('input[name="password"]').value;
    try {
      const response = await fetch("/api/login", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ email: email, password: password }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error("Login failed");
      }
      toastr.success("Login succesfull");
      setTimeout(() => {
        window.location.href = "/";
      }, 1000);
    } catch (error) {
      toastr.error("Login failed" + error.message);
    }
  };

  loginBtn.addEventListener("click", (event) => {
    event.preventDefault();
    loginUser();
  });
</script>
