<section class="section-card">
  <div class="section-header">
    <div>
      <h2 class="page-title">My orders</h2>
      <p class="section-copy">Track your recent purchases and open order details anytime.</p>
    </div>
  </div>
  <div class="my-orders item-list"></div>
</section>

<script>
  const getOrdersByUserId = async () => {
    try {
      const response = await fetch("/api/orders", {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
        },
      });

      if (!response.ok) {
        throw new Error("Failed to fetch orders");
      }

      const orders = await response.json();
      const ordersContainer = document.querySelector(".my-orders");
      ordersContainer.innerHTML = "";

      if (orders.length === 0) {
        ordersContainer.innerHTML =
          '<div class="page-empty">No orders yet. Your purchases will appear here after checkout.</div>';
        return;
      }

      orders.forEach((order) => {
        const orderElement = document.createElement("div");
        orderElement.classList.add("item-card");
        orderElement.innerHTML = `
          <h3>Order #${order.id}</h3>
          <p class="meta-text">${order.full_name}</p>
          <p class="meta-text">${order.email}</p>
          <p class="meta-text">${order.city}, ${order.zip}</p>
          <p class="price-tag">${order.payment_method}</p>
          <a href="/order/${order.id}" class="btn btn-secondary">View order details</a>
        `;
        ordersContainer.appendChild(orderElement);
      });
    } catch (error) {
      console.error("Error fetching orders:", error);
    }
  };

  getOrdersByUserId();
</script>
