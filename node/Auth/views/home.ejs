<h1>Welcome <%= name %></h1>

		<main class="product-grid">
  		<% products.forEach(product => { %>
    		<article class="product-card">
      			<h2><%= product.name %></h2>
      			<p class="price">Price: $<%= product.price %></p>
      			<p class="amount">Amount: <%= product.amount %></p>
    		</article>
  		<% }) %>
</main>