<div id="orders-container"></div>

<script>
	const ordersContainer = document.getElementById("orders-container");

	const formatPrice = (price) => {
		return new Intl.NumberFormat("en-US", {
			style: "currency",
			currency: "USD",
		}).format(price);
	};

	const getOrders = async () => {
		try {
			const response = await fetch("/api/orders");
			if (!response.ok) {
				throw new Error("Failed to fetch orders");
			}
			const orders = await response.json();
			console.log(orders);

			if (!orders || orders.length === 0) {
				ordersContainer.innerHTML = `
                    <div class="empty-orders">
                        <p>You have no orders yet.</p>
                        <a href="/products" class="btn">Start Shopping</a>
                    </div>
                `;
				return;
			}

			// Group orders by order ID (since query returns joined data)
			const ordersMap = {};
			orders.forEach((order) => {
				if (!ordersMap[order.order_id]) {
					ordersMap[order.order_id] = {
						id: order.order_id,
						fullName: order.full_name,
						email: order.email,
						address: order.address,
						city: order.city,
						zip: order.zip,
						items: [],
					};
				}
				ordersMap[order.order_id].items.push({
					name: order.item_name,
					quantity: order.quantity,
					price: order.item_price,
				});
			});

			const groupedOrders = Object.values(ordersMap);

			let ordersHtml = `<h1>Your Orders</h1><div class="orders-list">`;

			groupedOrders.forEach((order) => {
				const total = order.items.reduce(
					(sum, item) => sum + item.price * item.quantity,
					0,
				);

				ordersHtml += `
                    <div class="order-card">
                        <div class="order-header">
                            <div class="order-info">
                                <h2>Order #${order.id}</h2>
                            </div>
                        </div>
                        
                        <div class="order-details">
                            <div class="shipping-info">
                                <h3>Shipping Details</h3>
                                <p><strong>${order.fullName}</strong></p>
                                <p>${order.email}</p>
                                <p>${order.address}</p>
                                <p>${order.city}, ${order.zip}</p>
                            </div>
                            
                            <div class="order-items">
                                <h3>Items (${order.items.length})</h3>
                                <div class="items-list">
                                    ${order.items
																			.map(
																				(item) => `
                                        <div class="order-item">
                                            <div class="item-info">
                                                <span class="item-name">${item.name}</span>
                                                <span class="item-quantity">x${item.quantity}</span>
                                            </div>
                                            <span class="item-price">${formatPrice(item.price * item.quantity)}</span>
                                        </div>
                                    `,
																			)
																			.join("")}
                                </div>
                                <div class="order-total">
                                    <span>Total:</span>
                                    <span class="total-price">${formatPrice(total)}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
			});

			ordersHtml += `</div>`;
			ordersContainer.innerHTML = ordersHtml;
		} catch (error) {
			console.error("Error fetching orders:", error);
			ordersContainer.innerHTML = `<p class="error">Error loading orders. Please try again.</p>`;
		}
	};

	getOrders();
</script>

