
    <div class="container">
        <div class="header">
            <h1>🛍️ Products Catalog</h1>
            <p>Discover our amazing collection of tech products</p>
        </div>

        <a href="/" class="back-link">← Back to Home</a>

        <% if (products && products.length > 0) { %>
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-number"><%= products.length %></div>
                    <div class="stat-label">Total Products</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">$<%= (products.reduce((sum, p) => sum + (p.price / 100), 0)).toFixed(2) %></div>
                    <div class="stat-label">Total Value</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= products.reduce((sum, p) => sum + (p.amount || 0), 0) %></div>
                    <div class="stat-label">Items in Stock</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= products.filter(p => (p.amount || 0) === 0).length %></div>
                    <div class="stat-label">Out of Stock</div>
                </div>
            </div>

            <div class="products-grid">
                <% products.forEach(product => {
                    const stockStatus = (product.amount || 0) === 0 ? 'out-of-stock' :
                                      (product.amount || 0) < 10 ? 'low-stock' : 'in-stock';
                    const stockText = (product.amount || 0) === 0 ? 'Out of Stock' :
                                    (product.amount || 0) < 10 ? 'Low Stock' : 'In Stock';
                %>
                    <div class="product-card">
                        <div class="product-image">
                            <%= product.name.charAt(0).toUpperCase() %>
                        </div>
                        <div class="product-info">
                            <div class="product-name"><%= product.name %></div>
                            <div class="product-slug"><%= product.slug %></div>
                            <div class="product-price">$<%= (product.price / 100).toFixed(2) %></div>

                            <div class="product-stock">
                                <div class="stock-info">
                                    <span class="stock-badge <%= stockStatus %>"><%= stockText %></span>
                                    <% if (product.amount !== undefined && product.amount !== null) { %>
                                        <span>(<%= product.amount %> left)</span>
                                    <% } %>
                                </div>
                                <div class="product-id">#<%= product.id %></div>
                            </div>

                            <div class="product-actions">
                                <a href="/products/<%= product.slug %>" class="btn btn-primary">View Details</a>
                                <a href="/products/<%= product.slug %>/edit" class="btn btn-success">Edit</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="no-products">
                <h2>📦 No Products Found</h2>
                <p>There are currently no products in the catalog.</p>
                <a href="/products/new" class="btn btn-primary">Add First Product</a>
            </div>
        <% } %>
    </div>